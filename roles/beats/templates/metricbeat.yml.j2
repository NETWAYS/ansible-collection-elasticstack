---
metricbeat.config.modules:
  path: ${path.config}/modules.d/*.yml
  reload.enabled: false

setup.template.settings:
  index.number_of_shards: 1
{% if _beats_kibana_host | length > 0 %}
setup.kibana:
  host: {{ _beats_kibana_host | to_json }}
{% if beats_security | bool %}
{% if beats_elasticsearch_api_key | length > 0 %}
  api_key: {{ beats_elasticsearch_api_key | to_json }}
{% elif _beats_elasticsearch_username | length > 0 %}
  username: {{ _beats_elasticsearch_username | to_json }}
  password: {{ _beats_elasticsearch_password | to_json }}
{% endif %}
{% endif %}
{% if _beats_kibana_host is match('https://') %}
  ssl.enabled: true
  ssl.verification_mode: {{ beats_ssl_verification_mode }}
{% if _beats_kibana_ssl_certificate_authorities | length > 0 %}
  ssl.certificate_authorities: {{ _beats_kibana_ssl_certificate_authorities | to_json }}
{% endif %}
{% endif %}
{% endif %}
{% if beats_metricbeat_output == "elasticsearch" %}
output.elasticsearch:
{% if beats_security | bool %}
  hosts: [ {% for host in beats_elasticsearch_hosts %}"https://{{ host }}:{{ elasticstack_elasticsearch_http_port }}"{% if not loop.last %},{% endif %}{% endfor %}]
{% if beats_elasticsearch_api_key | length > 0 %}
  api_key: {{ beats_elasticsearch_api_key | to_json }}
{% else %}
  username: {{ _beats_elasticsearch_username | to_json }}
  password: {{ _beats_elasticsearch_password | to_json }}
{% endif %}
  ssl.enabled: true
  ssl.verification_mode: {{ beats_ssl_verification_mode }}
{% if _beats_ssl_certificate_authorities | length > 0 %}
  ssl.certificate_authorities: {{ _beats_ssl_certificate_authorities | to_json }}
{% endif %}
{% else %}
  hosts: [ {% for host in beats_elasticsearch_hosts %}"http://{{ host }}:{{ elasticstack_elasticsearch_http_port }}"{% if not loop.last %},{% endif %}{% endfor %}]
{% endif %}
{% endif %}
{% if beats_metricbeat_output == "logstash" %}
output.logstash:
  hosts: [ {% for host in beats_logstash_hosts %}"{{ host }}:{{ elasticstack_beats_port }}"{% if not loop.last %},{% endif %}{% endfor %}]
  loadbalance: {{ beats_metricbeat_loadbalance }}
{% if beats_security | bool %}
  ssl.enabled: true
  ssl.certificate_authorities: ["{{ beats_tls_cacert }}"]
  ssl.verification_mode: full
  ssl.key: {{ beats_tls_key }}
  ssl.key_passphrase: {{ beats_tls_key_passphrase }}
  ssl.certificate: {{ beats_tls_cert }}
{% endif %}
{% endif %}

{% if beats_logging == "file" %}
logging.level: {{ beats_loglevel }}
logging.to_files: true
logging.files:
  path: {{ beats_logpath }}/metricbeat.log
  name: metricbeat
  keepfiles: 7
  permissions: 0644
{% endif %}

processors:
  - add_host_metadata: ~
  - add_cloud_metadata: ~
