input {
{% for input in pipelinename.input %}

# {{ input.name }} input
  redis {
    host => "{{ logstash_redis_input_host }}"
{% if logstash_redis_tls | bool %}
    ssl => true
{% endif %}
    data_type => "list"
    key => "{{ input.key }}"
{% if logstash_redis_password is defined %}
    password => "{{ logstash_redis_password }}"
{% endif %}
  }
{% endfor %}

}
